{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=orders;Username=orders;Password=orders"
  },
  "RabbitMq": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "Exchange": "orders.exchange",
    "Queue": "orders.created",
    "RoutingKey": "order.created",
    "DeadLetterExchange": "orders.dlx",
    "DeadLetterQueue": "orders.dlq",
    "PrefetchCount": 8
  },
  "AllowedHosts": "*"
}
